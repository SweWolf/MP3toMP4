<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\MP3_to_MP4_Converter.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>MP3 to MP4</AssemblyTitle>
    <Description>Turns an audio file into a video file with a picture, video clips, a black screen or text.</Description>
    <Company>SweWolf Software</Company>
    <Product>MP3 to MP4</Product>
    <Copyright>SweWolf Software</Copyright>
    <Authors>SweWolf</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\MP3_to_MP4_Converter.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Help > MP3 to MP4 Help (F1). Rebuild it from help.md with docs\build-help.cmd -->
    <Content Include="docs\help.html" Link="Help\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>